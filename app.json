{
  "expo": {
    "name": "KSD",
    "slug": "KSD",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.itglansa.KSD"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow KisanSahakar to use the microphone for voice input",
          "speechRecognitionPermission": "Allow KisanSahakar to use speech recognition"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4bfd9290-2429-4296-b645-655f692413ba"
      }
    }
  }
}